# GraphikosX — environment variables
#
# The site runs with ZERO environment variables set: every form works in a
# development-safe way out of the box (see README.md → "Lead capture
# architecture"). Every variable below is OPTIONAL and additive — setting it
# turns on one more piece of production infrastructure with no code changes.
#
# Never commit a real .env / .env.local file. Copy this file to .env.local
# and fill in real values there for local testing; set the real values in
# your hosting provider's environment variable dashboard (e.g. Vercel
# Project Settings → Environment Variables) for production.

# ── Lead delivery: PRIMARY (webhook / CRM / automation) ─────────────────────
# POST target for every Free Audit / Contact submission (JSON body). Point
# this at a Zapier/Make/n8n webhook, a Google Sheets webhook, or a CRM's
# inbound webhook URL.
LEAD_WEBHOOK_URL=

# ── Lead delivery: BACKUP (transactional email to sales@graphikosx.in) ─────
# Resend API key (https://resend.com). Required for email notifications.
EMAIL_API_KEY=
# Verified sender identity in your Resend account, e.g.
# "GraphikosX Leads <leads@graphikosx.in>". Required alongside EMAIL_API_KEY.
EMAIL_FROM=
# Optional override for the notification recipient. Defaults to
# sales@graphikosx.in (src/lib/data/company.ts) if unset.
EMAIL_TO=

# ── Rate limiting: production-safe adapter (optional) ───────────────────────
# Upstash Redis REST credentials (Upstash dashboard → REST API). If either
# is unset, rate limiting falls back to an in-memory limiter that is NOT
# shared across serverless instances — fine for a single Node server, not
# sufficient for real distributed protection. See src/lib/leads/rateLimit.ts.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=

# ── Analytics (optional) ─────────────────────────────────────────────────
# GA4 Measurement ID (e.g. G-XXXXXXXXXX). If unset, no analytics script
# loads and every track() call in src/lib/analytics/track.ts safely no-ops.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
